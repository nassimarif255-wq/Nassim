rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'nassimarif255@gmail.com';
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // Official team projects & member portraits: public read, admin-only write
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isVerifiedAdmin() && isValidImageUpload();
    }

    match /artisans/{allPaths=**} {
      allow read: if true;
      allow write: if isVerifiedAdmin() && isValidImageUpload();
    }

    // Customer service request attachments: owner + admin only
    match /requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null &&
        request.auth.token.email_verified == true &&
        (request.auth.uid == userId || isVerifiedAdmin());
      allow write: if request.auth != null &&
        request.auth.token.email_verified == true &&
        (request.auth.uid == userId || isVerifiedAdmin()) &&
        isValidImageUpload();
    }
  }
}

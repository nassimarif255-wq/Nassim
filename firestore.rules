rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'nassimarif255@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidServiceCategory(cat) {
      return cat in [
        'construction_renovation',
        'ceramics',
        'welding',
        'electricity',
        'plumbing',
        'carpentry',
        'painting',
        'hvac',
        'solar'
      ];
    }

    function isValidProjectCategory(cat) {
      return isValidServiceCategory(cat) ||
        cat in ['construction', 'renovation', 'kitchen_bath', 'facades'];
    }

    function isValidImageUri(uri) {
      return uri is string &&
        uri.size() >= 10 &&
        uri.size() <= 450000 &&
        (uri.matches('^https://.*') || uri.matches('^data:image/(jpeg|jpg|png|webp);base64,.*'));
    }

    function isOptionalImageUri(uri) {
      return uri is string && (uri.size() == 0 || isValidImageUri(uri));
    }

    function isValidTagList(arr) {
      return arr is list &&
        arr.size() <= 12 &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 80));
    }

    // Validation Blueprint: Project
    function isValidProject(data) {
      return data.keys().hasAll([
          'title', 'category', 'location', 'areaSqm',
          'description', 'coverImage', 'ownerId', 'ownerName',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'location', 'areaSqm',
          'description', 'coverImage', 'beforeImage',
          'completedServices', 'artisanId',
          'ownerId', 'ownerName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        isValidProjectCategory(data.category) &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 80 &&
        data.areaSqm is string && data.areaSqm.size() >= 1 && data.areaSqm.size() <= 30 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1500 &&
        isValidImageUri(data.coverImage) &&
        (!('beforeImage' in data) || isOptionalImageUri(data.beforeImage)) &&
        (!('completedServices' in data) || isValidTagList(data.completedServices)) &&
        (!('artisanId' in data) || (data.artisanId is string && (data.artisanId.size() == 0 || isValidId(data.artisanId)))) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Photo Subcollection Item
    function isValidPhotoItem(data) {
      return data.keys().hasAll(['imageUrl', 'caption', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['imageUrl', 'caption', 'ownerId', 'createdAt']) &&
        isValidImageUri(data.imageUrl) &&
        data.caption is string && data.caption.size() <= 200 &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: ArtisanProfile (Official Team Member)
    function isValidArtisan(data) {
      return data.keys().hasAll([
          'displayName', 'profession', 'experienceYears',
          'wilaya', 'commune', 'bio', 'avatarUrl',
          'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'displayName', 'roleTitle', 'profession', 'experienceYears',
          'wilaya', 'commune', 'bio', 'skillsList', 'avatarUrl',
          'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 100)) &&
        isValidServiceCategory(data.profession) &&
        data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 80 &&
        data.wilaya is string && data.wilaya.size() >= 2 && data.wilaya.size() <= 60 &&
        data.commune is string && data.commune.size() >= 2 && data.commune.size() <= 60 &&
        data.bio is string && data.bio.size() >= 10 && data.bio.size() <= 1200 &&
        (!('skillsList' in data) || isValidTagList(data.skillsList)) &&
        isOptionalImageUri(data.avatarUrl) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: TeamSkill (Admin Managed)
    function isValidTeamSkill(data) {
      return data.keys().hasAll([
          'nameAr', 'nameFr', 'category', 'level',
          'summaryAr', 'summaryFr', 'toolsAr', 'sortOrder',
          'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'nameAr', 'nameFr', 'category', 'level',
          'summaryAr', 'summaryFr', 'toolsAr', 'sortOrder',
          'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 100 &&
        data.nameFr is string && data.nameFr.size() >= 2 && data.nameFr.size() <= 100 &&
        isValidServiceCategory(data.category) &&
        data.level in ['expert', 'advanced', 'certified'] &&
        data.summaryAr is string && data.summaryAr.size() >= 5 && data.summaryAr.size() <= 350 &&
        data.summaryFr is string && data.summaryFr.size() >= 5 && data.summaryFr.size() <= 350 &&
        data.toolsAr is string && data.toolsAr.size() <= 180 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 999 &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: TeamServiceGuide (Admin Managed)
    function isValidTeamService(data) {
      return data.keys().hasAll([
          'titleAr', 'titleFr', 'category',
          'natureAr', 'natureFr', 'deliverablesAr', 'deliverablesFr',
          'stagesAr', 'stagesFr', 'outcomeAr', 'outcomeFr',
          'durationLabel', 'sortOrder', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'titleAr', 'titleFr', 'category',
          'natureAr', 'natureFr', 'deliverablesAr', 'deliverablesFr',
          'stagesAr', 'stagesFr', 'outcomeAr', 'outcomeFr',
          'durationLabel', 'sortOrder', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.titleAr is string && data.titleAr.size() >= 3 && data.titleAr.size() <= 120 &&
        data.titleFr is string && data.titleFr.size() >= 3 && data.titleFr.size() <= 120 &&
        isValidServiceCategory(data.category) &&
        data.natureAr is string && data.natureAr.size() >= 5 && data.natureAr.size() <= 600 &&
        data.natureFr is string && data.natureFr.size() >= 5 && data.natureFr.size() <= 600 &&
        data.deliverablesAr is string && data.deliverablesAr.size() >= 5 && data.deliverablesAr.size() <= 900 &&
        data.deliverablesFr is string && data.deliverablesFr.size() >= 5 && data.deliverablesFr.size() <= 900 &&
        data.stagesAr is string && data.stagesAr.size() >= 5 && data.stagesAr.size() <= 900 &&
        data.stagesFr is string && data.stagesFr.size() >= 5 && data.stagesFr.size() <= 900 &&
        data.outcomeAr is string && data.outcomeAr.size() >= 5 && data.outcomeAr.size() <= 500 &&
        data.outcomeFr is string && data.outcomeFr.size() >= 5 && data.outcomeFr.size() <= 500 &&
        data.durationLabel is string && data.durationLabel.size() >= 1 && data.durationLabel.size() <= 60 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 999 &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: ServiceRequest (No PII)
    function isValidServiceRequest(data) {
      return data.keys().hasAll([
          'title', 'category', 'wilaya', 'commune',
          'description', 'coverImage', 'status',
          'ownerId', 'ownerName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'wilaya', 'commune',
          'description', 'coverImage', 'status',
          'ownerId', 'ownerName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        isValidServiceCategory(data.category) &&
        data.wilaya is string && data.wilaya.size() >= 2 && data.wilaya.size() <= 60 &&
        data.commune is string && data.commune.size() >= 2 && data.commune.size() <= 60 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 1500 &&
        isOptionalImageUri(data.coverImage) &&
        data.status in ['open', 'in_progress', 'closed'] &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Private Inquiry / Direct Message
    function isValidInquiry(data) {
      return data.keys().hasAll([
          'senderId', 'senderName', 'recipientOwnerId', 'recipientName',
          'contextType', 'contextId', 'contextTitle',
          'message', 'contactInfo', 'replyText', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'senderId', 'senderName', 'recipientOwnerId', 'recipientName',
          'contextType', 'contextId', 'contextTitle',
          'message', 'contactInfo', 'replyText', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.senderId is string && isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
        data.recipientOwnerId is string && isValidId(data.recipientOwnerId) &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 100 &&
        data.contextType in ['artisan', 'request'] &&
        data.contextId is string && isValidId(data.contextId) &&
        data.contextTitle is string && data.contextTitle.size() >= 1 && data.contextTitle.size() <= 120 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1000 &&
        data.contactInfo is string && data.contactInfo.size() <= 120 &&
        data.replyText is string && data.replyText.size() <= 1000 &&
        data.status in ['pending', 'replied'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Startup connection check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Admin registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerifiedUser() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // 0A. Official Team Skills & Expertise (Public Read, Admin Write)
    match /skills/{skillId} {
      allow get: if isValidId(skillId);
      allow list: if true;

      allow create: if isAdmin() &&
        isValidId(skillId) &&
        isValidTeamSkill(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(skillId) &&
        isValidTeamSkill(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nameAr', 'nameFr', 'category', 'level',
          'summaryAr', 'summaryFr', 'toolsAr', 'sortOrder', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(skillId);
    }

    // 0B. Official Detailed Service Guides (Public Read, Admin Write)
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;

      allow create: if isAdmin() &&
        isValidId(serviceId) &&
        isValidTeamService(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(serviceId) &&
        isValidTeamService(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'titleAr', 'titleFr', 'category',
          'natureAr', 'natureFr', 'deliverablesAr', 'deliverablesFr',
          'stagesAr', 'stagesFr', 'outcomeAr', 'outcomeFr',
          'durationLabel', 'sortOrder', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(serviceId);
    }

    // 1. Public Projects Showcase (No PII; intentionally public read)
    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'location', 'areaSqm',
          'description', 'coverImage', 'beforeImage',
          'completedServices', 'artisanId', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(projectId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      match /photos/{photoId} {
        allow get: if isValidId(projectId) && isValidId(photoId);
        allow list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(projectId) &&
          isValidId(photoId) &&
          isValidPhotoItem(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          (
            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );

        allow delete: if isVerifiedUser() &&
          isValidId(projectId) &&
          isValidId(photoId) &&
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          (
            existing().ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // 2. Team Craftsmen Directory (No PII; intentionally public read)
    match /artisans/{artisanId} {
      allow get: if isValidId(artisanId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(artisanId) &&
        isValidArtisan(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(artisanId) &&
        isValidArtisan(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'roleTitle', 'profession', 'experienceYears',
          'wilaya', 'commune', 'bio', 'skillsList', 'avatarUrl', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(artisanId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      match /photos/{photoId} {
        allow get: if isValidId(artisanId) && isValidId(photoId);
        allow list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(artisanId) &&
          isValidId(photoId) &&
          isValidPhotoItem(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/artisans/$(artisanId)) &&
          (
            get(/databases/$(database)/documents/artisans/$(artisanId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );

        allow delete: if isVerifiedUser() &&
          isValidId(artisanId) &&
          isValidId(photoId) &&
          exists(/databases/$(database)/documents/artisans/$(artisanId)) &&
          (
            existing().ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/artisans/$(artisanId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // 3. Customer Service Requests Board (No PII; intentionally public read)
    match /requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidServiceRequest(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidServiceRequest(incoming()) &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'closed' &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'wilaya', 'commune',
              'description', 'coverImage', 'status', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(requestId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      match /photos/{photoId} {
        allow get: if isValidId(requestId) && isValidId(photoId);
        allow list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(requestId) &&
          isValidId(photoId) &&
          isValidPhotoItem(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/requests/$(requestId)) &&
          (
            get(/databases/$(database)/documents/requests/$(requestId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );

        allow delete: if isVerifiedUser() &&
          isValidId(requestId) &&
          isValidId(photoId) &&
          exists(/databases/$(database)/documents/requests/$(requestId)) &&
          (
            existing().ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // 4. Private Client <-> Team Inquiries (Strictly Isolated)
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) &&
        isVerifiedUser() &&
        (
          existing().senderId == request.auth.uid ||
          existing().recipientOwnerId == request.auth.uid ||
          isAdmin()
        );

      allow list: if isVerifiedUser() &&
        (
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientOwnerId == request.auth.uid ||
          request.auth.token.email == 'nassimarif255@gmail.com'
        );

      allow create: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().senderId == request.auth.uid &&
        incoming().senderId != incoming().recipientOwnerId &&
        incoming().status == 'pending' &&
        incoming().replyText == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        (
          isAdmin() ||
          (
            existing().recipientOwnerId == request.auth.uid &&
            existing().status != 'replied' &&
            incoming().status == 'replied' &&
            incoming().replyText.size() >= 1 &&
            incoming().senderId == existing().senderId &&
            incoming().recipientOwnerId == existing().recipientOwnerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'replyText', 'status', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        (existing().senderId == request.auth.uid || isAdmin());
    }
  }
}

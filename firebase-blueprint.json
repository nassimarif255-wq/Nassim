{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A real completed construction, ceramics, or home renovation project published by the dz darkom pro admin with optional before/after comparison.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar",
            "construction",
            "renovation",
            "kitchen_bath",
            "facades"
          ]
        },
        "location": { "type": "string", "minLength": 2, "maxLength": 80 },
        "areaSqm": { "type": "string", "minLength": 1, "maxLength": 30 },
        "description": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "coverImage": { "type": "string", "minLength": 10, "maxLength": 450000 },
        "beforeImage": { "type": "string", "minLength": 0, "maxLength": 450000 },
        "completedServices": { "type": "array" },
        "specialties": { "type": "array" },
        "artisanId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "location", "areaSqm", "description", "coverImage", "ownerId", "ownerName", "createdAt", "updatedAt"]
    },
    "ProjectPhoto": {
      "title": "ProjectPhoto",
      "description": "Additional gallery photo attached to a project, team member profile, or customer service request.",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string", "minLength": 10, "maxLength": 450000 },
        "caption": { "type": "string", "minLength": 0, "maxLength": 200 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "caption", "ownerId", "createdAt"]
    },
    "ArtisanProfile": {
      "title": "ArtisanProfile",
      "description": "Official team member profile managed exclusively by admin, including specialty, experience, location, skills, tools, and linked works.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "roleTitle": { "type": "string", "minLength": 0, "maxLength": 100 },
        "profession": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "experienceYears": { "type": "number" },
        "wilaya": { "type": "string", "minLength": 2, "maxLength": 60 },
        "commune": { "type": "string", "minLength": 2, "maxLength": 60 },
        "bio": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "skillsList": { "type": "array" },
        "toolsList": { "type": "array" },
        "avatarUrl": { "type": "string", "minLength": 0, "maxLength": 450000 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "profession", "experienceYears", "wilaya", "commune", "bio", "avatarUrl", "ownerId", "createdAt", "updatedAt"]
    },
    "TeamSkill": {
      "title": "TeamSkill",
      "description": "Detailed team skill managed exclusively by admin, linking specialty, mastery level, tools, executable tasks, and assigned team member.",
      "type": "object",
      "properties": {
        "nameAr": { "type": "string", "minLength": 2, "maxLength": 100 },
        "nameFr": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "level": { "type": "string", "enum": ["expert", "advanced", "certified"] },
        "experienceLabel": { "type": "string", "minLength": 0, "maxLength": 60 },
        "summaryAr": { "type": "string", "minLength": 5, "maxLength": 450 },
        "summaryFr": { "type": "string", "minLength": 5, "maxLength": 450 },
        "toolsAr": { "type": "string", "minLength": 0, "maxLength": 220 },
        "toolsFr": { "type": "string", "minLength": 0, "maxLength": 220 },
        "tasksAr": { "type": "string", "minLength": 0, "maxLength": 600 },
        "tasksFr": { "type": "string", "minLength": 0, "maxLength": 600 },
        "artisanId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "sortOrder": { "type": "number" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameAr", "nameFr", "category", "level", "summaryAr", "summaryFr", "toolsAr", "sortOrder", "ownerId", "createdAt", "updatedAt"]
    },
    "TeamServiceGuide": {
      "title": "TeamServiceGuide",
      "description": "Comprehensive service sheet managed by admin covering definition, deliverables, stages, materials/tools, quality standards, client outcome, and optional estimated duration.",
      "type": "object",
      "properties": {
        "titleAr": { "type": "string", "minLength": 3, "maxLength": 120 },
        "titleFr": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "natureAr": { "type": "string", "minLength": 5, "maxLength": 600 },
        "natureFr": { "type": "string", "minLength": 5, "maxLength": 600 },
        "deliverablesAr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "deliverablesFr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "stagesAr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "stagesFr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "materialsToolsAr": { "type": "string", "minLength": 0, "maxLength": 600 },
        "materialsToolsFr": { "type": "string", "minLength": 0, "maxLength": 600 },
        "qualityStandardsAr": { "type": "string", "minLength": 0, "maxLength": 600 },
        "qualityStandardsFr": { "type": "string", "minLength": 0, "maxLength": 600 },
        "outcomeAr": { "type": "string", "minLength": 5, "maxLength": 500 },
        "outcomeFr": { "type": "string", "minLength": 5, "maxLength": 500 },
        "durationLabel": { "type": "string", "minLength": 0, "maxLength": 60 },
        "sortOrder": { "type": "number" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleAr", "titleFr", "category", "natureAr", "natureFr", "deliverablesAr", "deliverablesFr", "stagesAr", "stagesFr", "outcomeAr", "outcomeFr", "durationLabel", "sortOrder", "ownerId", "createdAt", "updatedAt"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Private customer service request submitted to the dz darkom pro team (visible only to request owner and admin).",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "wilaya": { "type": "string", "minLength": 2, "maxLength": 60 },
        "commune": { "type": "string", "minLength": 2, "maxLength": 60 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "coverImage": { "type": "string", "minLength": 0, "maxLength": 450000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "closed"] },
        "adminNote": { "type": "string", "minLength": 0, "maxLength": 500 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "wilaya", "commune", "description", "coverImage", "status", "adminNote", "ownerId", "ownerName", "createdAt", "updatedAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Private direct communication message between a customer and the dz darkom pro team.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "recipientOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contextType": { "type": "string", "enum": ["team", "artisan", "request"] },
        "contextId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contextTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "contactInfo": { "type": "string", "minLength": 0, "maxLength": 120 },
        "replyText": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "recipientOwnerId", "recipientName", "contextType", "contextId", "contextTitle", "message", "contactInfo", "replyText", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/skills/{skillId}": {
      "schema": { "$ref": "#/entities/TeamSkill" },
      "description": "Public catalog of team technical skills managed exclusively by admin."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/TeamServiceGuide" },
      "description": "Public detailed service guides managed exclusively by admin."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Public showcase of real team projects with before/after comparison, managed exclusively by admin."
    },
    "/projects/{projectId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ProjectPhoto" },
      "description": "Additional project photos managed exclusively by admin."
    },
    "/artisans/{artisanId}": {
      "schema": { "$ref": "#/entities/ArtisanProfile" },
      "description": "Official team member profiles managed exclusively by admin."
    },
    "/artisans/{artisanId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ProjectPhoto" },
      "description": "Portfolio photos attached to a team member profile, managed exclusively by admin."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Private customer service requests visible only to the submitting user and admin."
    },
    "/requests/{requestId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ProjectPhoto" },
      "description": "Photos attached by the customer to their private service request."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Private direct messages between customers and the team."
    }
  }
}

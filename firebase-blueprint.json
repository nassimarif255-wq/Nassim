{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A public construction, ceramics, welding, or home renovation project showcased by the dz darkom pro team with optional before/after comparison.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "welding",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar",
            "construction",
            "renovation",
            "kitchen_bath",
            "facades"
          ]
        },
        "location": { "type": "string", "minLength": 2, "maxLength": 80 },
        "areaSqm": { "type": "string", "minLength": 1, "maxLength": 30 },
        "description": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "coverImage": { "type": "string", "minLength": 10, "maxLength": 450000 },
        "beforeImage": { "type": "string", "minLength": 0, "maxLength": 450000 },
        "completedServices": { "type": "array" },
        "artisanId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "location", "areaSqm", "description", "coverImage", "ownerId", "ownerName", "createdAt", "updatedAt"]
    },
    "ProjectPhoto": {
      "title": "ProjectPhoto",
      "description": "Additional gallery photo attached to a project, team craftsman profile, or customer request.",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string", "minLength": 10, "maxLength": 450000 },
        "caption": { "type": "string", "minLength": 0, "maxLength": 200 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "caption", "ownerId", "createdAt"]
    },
    "ArtisanProfile": {
      "title": "ArtisanProfile",
      "description": "Official team craftsman profile on dz darkom pro including specialty, experience, location, skills, and portfolio.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "roleTitle": { "type": "string", "minLength": 0, "maxLength": 100 },
        "profession": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "welding",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "experienceYears": { "type": "number" },
        "wilaya": { "type": "string", "minLength": 2, "maxLength": 60 },
        "commune": { "type": "string", "minLength": 2, "maxLength": 60 },
        "bio": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "skillsList": { "type": "array" },
        "avatarUrl": { "type": "string", "minLength": 0, "maxLength": 450000 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "profession", "experienceYears", "wilaya", "commune", "bio", "avatarUrl", "ownerId", "createdAt", "updatedAt"]
    },
    "TeamSkill": {
      "title": "TeamSkill",
      "description": "Team skill and technical expertise managed by admin on dz darkom pro.",
      "type": "object",
      "properties": {
        "nameAr": { "type": "string", "minLength": 2, "maxLength": 100 },
        "nameFr": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "welding",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "level": { "type": "string", "enum": ["expert", "advanced", "certified"] },
        "summaryAr": { "type": "string", "minLength": 5, "maxLength": 350 },
        "summaryFr": { "type": "string", "minLength": 5, "maxLength": 350 },
        "toolsAr": { "type": "string", "minLength": 0, "maxLength": 180 },
        "sortOrder": { "type": "number" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameAr", "nameFr", "category", "level", "summaryAr", "summaryFr", "toolsAr", "sortOrder", "ownerId", "createdAt", "updatedAt"]
    },
    "TeamServiceGuide": {
      "title": "TeamServiceGuide",
      "description": "Detailed service guide explaining nature of work, deliverables, execution stages, and client outcomes.",
      "type": "object",
      "properties": {
        "titleAr": { "type": "string", "minLength": 3, "maxLength": 120 },
        "titleFr": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "welding",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "natureAr": { "type": "string", "minLength": 5, "maxLength": 600 },
        "natureFr": { "type": "string", "minLength": 5, "maxLength": 600 },
        "deliverablesAr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "deliverablesFr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "stagesAr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "stagesFr": { "type": "string", "minLength": 5, "maxLength": 900 },
        "outcomeAr": { "type": "string", "minLength": 5, "maxLength": 500 },
        "outcomeFr": { "type": "string", "minLength": 5, "maxLength": 500 },
        "durationLabel": { "type": "string", "minLength": 1, "maxLength": 60 },
        "sortOrder": { "type": "number" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleAr", "titleFr", "category", "natureAr", "natureFr", "deliverablesAr", "deliverablesFr", "stagesAr", "stagesFr", "outcomeAr", "outcomeFr", "durationLabel", "sortOrder", "ownerId", "createdAt", "updatedAt"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Customer service request sent to the dz darkom pro team specifying specialty, details, and wilaya/commune.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "construction_renovation",
            "ceramics",
            "welding",
            "electricity",
            "plumbing",
            "carpentry",
            "painting",
            "hvac",
            "solar"
          ]
        },
        "wilaya": { "type": "string", "minLength": 2, "maxLength": 60 },
        "commune": { "type": "string", "minLength": 2, "maxLength": 60 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "coverImage": { "type": "string", "minLength": 0, "maxLength": 450000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "closed"] },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "wilaya", "commune", "description", "coverImage", "status", "ownerId", "ownerName", "createdAt", "updatedAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Private two-way message and contact exchange between a client and the dz darkom pro team.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "recipientOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contextType": { "type": "string", "enum": ["artisan", "request"] },
        "contextId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contextTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "contactInfo": { "type": "string", "minLength": 0, "maxLength": 120 },
        "replyText": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "recipientOwnerId", "recipientName", "contextType", "contextId", "contextTitle", "message", "contactInfo", "replyText", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/skills/{skillId}": {
      "schema": { "$ref": "#/entities/TeamSkill" },
      "description": "Public directory of official team skills & specialties managed by admin."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/TeamServiceGuide" },
      "description": "Public detailed service guides covering nature, deliverables, stages, and outcomes."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Public showcase of real projects with before/after comparison across all specialties."
    },
    "/projects/{projectId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ProjectPhoto" },
      "description": "Additional photos for a project."
    },
    "/artisans/{artisanId}": {
      "schema": { "$ref": "#/entities/ArtisanProfile" },
      "description": "Official team craftsman profiles with specialty, experience, skills, and portfolio."
    },
    "/artisans/{artisanId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ProjectPhoto" },
      "description": "Portfolio photos attached to a team craftsman profile."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Customer service requests directed to the team."
    },
    "/requests/{requestId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ProjectPhoto" },
      "description": "Problem photos attached to a customer service request."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Private direct communication messages between clients and team craftsmen."
    }
  }
}
